{
	"compilerOptions": {
		"composite": true,
		"target": "ES2022",
		"useDefineForClassFields": true,
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"moduleDetection": "force",
		"noEmit": true,
		"jsx": "react-jsx",

		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedSideEffectImports": true,
		"noUncheckedIndexedAccess": true,

		// TS 7 removed `baseUrl`; `paths` resolve relative to this file, so the
		// mapping must be explicitly relative.
		"paths": {
			"@/*": ["./src/*"]
		},
		"skipLibCheck": true,
		"types": []
	},
	// `../core/wire.ts` is the canonical wire vocabulary (warren-b229). It is
	// outside this package's `src/` on purpose — it is the one module the
	// server, the SDK and this UI all import so the enums can never drift.
	// A composite project must list every file it compiles, so naming it here
	// is what makes `import "../../../core/wire.ts"` resolve under `tsc -b`.
	"include": ["src", "../core/wire.ts"],
	"exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
